{
  "manifest_version": 3,
  "name": "Jadwal Sholat Akurat",
  "version": "2.3.0",
  "description": "Jadwal, hitung mundur, dan notifikasi waktu sholat berdasarkan lokasi.",
  "icons": {
    "128": "icon128.png"
  },
  "permissions": ["storage", "notifications", "alarms"],
  "host_permissions": ["https://api.aladhan.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon128.png",
      "32": "icon128.png"
    },
    "default_title": "Jadwal Sholat"
  }
}